extends layout

block content
  .flex.justify-between.items-center.mb-4
    h1 #{title}
    a.btn.btn-outline(href=`/listings/${item.id}`) Back to Item
    
  .card(style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; min-height: 400px; padding: 0;")
    .card-header(style="background: var(--bg-light); padding: 15px 25px; margin: 0; border-bottom: 1px solid var(--border-color);")
      h3(style="margin: 0;") Chatting about #{item.title}
      
    div(style="flex: 1; padding: 25px; overflow-y: auto; display: flex; flex-direction: column; gap: 15px;")
      if messages && messages.length > 0
        each msg in messages
          div(style=`display: flex; flex-direction: column; ${msg.sender_id === user.id ? "align-items: flex-end;" : "align-items: flex-start;"}`)
            div(style=`max-width: 70%; padding: 12px 18px; border-radius: 15px; ${msg.sender_id === user.id ? "background: var(--primary-color); color: white; border-bottom-right-radius: 2px;" : "background: #e9ecef; color: var(--text-primary); border-bottom-left-radius: 2px;"}`)
              if msg.sender_id !== user.id
                strong(style="font-size: 0.8em; display: block; margin-bottom: 3px; color: var(--primary-hover);")= msg.sender_name
              p(style="margin: 0;")= msg.content
            small.text-secondary(style="margin-top: 5px; font-size: 0.7em;")= new Date(msg.created_at).toLocaleString()
      else
        p.text-secondary.text-center No messages yet. Start the conversation!
        
    div(style="padding: 20px; border-top: 1px solid var(--border-color); background: #fafafa;")
      form(method="POST" action=`/messages/${item.id}` style="display: flex; gap: 10px;")
        input(type="hidden" name="receiver_id" value=receiverId)
        input.form-control(type="text" name="content" required placeholder="Type a message..." style="flex: 1;")
        button.btn.btn-primary(type="submit") Send ✉️
